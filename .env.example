# Copy to .env or set these in your host's environment settings
PORT=3000
NODE_ENV=production
# Where km.db is kept. Use a persistent disk path in production.
DATA_DIR=./data
# Only used the first time, when there are no users yet
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=change-this-long-password
# Time zone for reports pulled by other apps, as minutes from UTC the way
# JavaScript counts them: India is -330, UTC is 0. Default is -330.
DEFAULT_TZ_OFFSET=-330
# Optional. If unset, a random secret is created and kept in the database.
# JWT_SECRET=
# Map tiles for the admin map. Default is OpenStreetMap (free, small teams only).
# For many users use a paid tile service and put its address here.
# TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
